{
  "name": "@desk-agent/mac",
  "version": "0.1.0",
  "private": true,
  "description": "Desk Agent macOS app shell",
  "author": "Desk Agent",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm build:native && electron-vite dev",
    "build": "electron-vite build",
    "build:native": "bash scripts/build-native.sh",
    "test:native": "bash native/display-helper/scripts/test.sh",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pack": "pnpm build && pnpm build:native && electron-builder --mac"
  },
  "dependencies": {
    "@desk-agent/config-schema": "workspace:*",
    "@desk-agent/core": "workspace:*",
    "@desk-agent/protocol": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "com.deskagent.mac",
    "productName": "Desk Agent",
    "asar": true,
    "afterPack": "../../scripts/mac-signing/afterPack.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "extraFiles": [
      {
        "from": "native-bin",
        "to": "Helpers",
        "filter": [
          "desk-agent-display-helper"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "DeskAgent-${version}-mac-arm64.${ext}",
      "identity": null,
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    }
  }
}
